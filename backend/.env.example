# Mẫu cấu hình backend — copy thành `.env` rồi chỉnh nếu cần.
#   cp .env.example .env
# Tên biến KHÔNG phân biệt hoa/thường (case_sensitive=false).
# DATN_6 dùng LLM LOCAL qua Ollama — KHÔNG cần API key, không tốn phí.

# === Ollama (LLM local) ===
# Cài Ollama: https://ollama.com/download , rồi pull model:
#   ollama pull qwen2.5:7b-instruct
# Ollama chạy nền sẵn sau khi cài (mặc định cổng 11434).
# ollama_base_url=http://localhost:11434
# Danh sách model ngăn cách dấu phẩy — model trước lỗi thì tự thử model sau:
#ollama_model=qwen2.5:7b-instruct
# Model RIÊNG cho từng bước (vd 2 model fine-tune). Bỏ trống -> dùng ollama_model.
# extraction_model=
# validation_model=
# Cửa sổ ngữ cảnh (chống cắt cụt payload kiểm tra dài = rag_total_cap đoạn luật + các
# trường đã trích). Máy yếu RAM có thể giảm (vd 4096); máy khỏe tăng (vd 16384).
# Tăng rag_total_cap thì PHẢI tăng num_ctx theo, nếu không payload bị cắt cụt.
# ollama_num_ctx=8192
# Giữ model nạp sẵn giữa các request (tránh nạp lại mỗi lần -> nhanh hơn). '0' = thả ngay.
# ollama_keep_alive=5m

# === OCR: Vintern-1B-v3.5 (tùy chọn) ===
# Mô hình thị giác-ngôn ngữ tiếng Việt chạy cục bộ. Lần đầu tự tải ~1 GB từ Hugging Face.
# Revision được GHIM trong code (mô hình dùng trust_remote_code) — chỉ đổi khi chủ động nâng cấp.
# vintern_revision=b98f263eab246eb5269ade64edbdca8a887dc44d
# Thiết bị: auto (có CUDA thì GPU, không thì CPU) | cuda | cpu.
# GPU dùng chung với Ollama (~2-3 GB VRAM). CPU chậm hơn nhiều (ước 1-3 phút/trang scan).
# vintern_device=auto
# Trần token sinh mỗi trang (trang dày chạm trần thì tự chia đôi rồi đọc từng nửa).
# vintern_max_new_tokens=2048
# Phạt lặp NHẸ — mức cao làm sai cụm số lặp trong số tiền ("1.000.000").
# vintern_repetition_penalty=1.05
# Nạp sẵn model lúc khởi động backend: vintern_warmup=true
# DPI render trang (số ô ảnh + số đoạn luật đi theo bảng bậc ở app/data/settings.json).
# ocr_dpi=200
# ocr_low_conf_threshold=0.6
# Đối chứng lớp chữ nhúng trong PDF với ảnh (chống chữ ẩn). Lệch dưới ngưỡng -> đọc ảnh.
# ocr_text_layer_verify=true
# ocr_text_layer_min_agreement=0.5


# === Chế độ mặc định ===
# Trích xuất bằng LLM nay là bước NGẦM cố định (mặc định BẬT, không hiện trên giao diện).
# Muốn tắt hẳn (chỉ dùng regex): use_llm_extraction=false
# use_llm_extraction=true

# === Bảo mật API ===
# CORS: bỏ trống = CHỈ origin loopback (http://localhost:*, http://127.0.0.1:*).
# KHÔNG đặt "*": mọi trang web mở trong trình duyệt sẽ đọc được hồ sơ qua API.
# cors_allow_origins=http://localhost:5173,https://ten-mien-frontend
# Tên máy hợp lệ trong header Host (chống DNS rebinding):
# allowed_hosts=localhost,127.0.0.1
# Mã quản trị (/admin/*). Bỏ trống -> tự sinh, lưu ở app/data/.admin_token, in ra console.
# admin_token=doi-thanh-chuoi-bi-mat-dai

# === Embedding / Reranker (RAG) ===
# Model embedding: mặc định tiếng Việt (bkai-foundation-models/vietnamese-bi-encoder).
# ĐỔI model -> PHẢI chạy lại: npm run seed. Muốn nhẹ, không tải model VN:
# embedding_model=sentence-transformers/all-MiniLM-L6-v2
# Reranker (sắp lại đoạn luật cho SÁT nghĩa) — mặc định BẬT (lần đầu tải ~1GB; không
# tải được thì tự bỏ qua, sắp theo khoảng cách vector). Tắt hẳn: use_reranker=false
# use_reranker=true
# reranker_model=BAAI/bge-reranker-v2-m3
# Số đoạn luật TỐI ĐA gửi LLM đối chiếu trong 1 lần gọi (bảng bậc DPI ghi đè khóa này). Tăng thì PHẢI tăng
# ollama_num_ctx theo, nếu không payload bị cắt cụt. Phần bắt buộc (2 đoạn/trường)
# luôn được giữ dù cap nhỏ.
# rag_total_cap=16

# === Trích xuất (tùy chọn) ===
# Gửi kèm few-shot examples trong payload trích xuất. Model đã fine-tune -> đặt false
# (model đã học format, tiết kiệm token):
# llm_send_examples=true
# Cơ chế bắt giá trị theo nhãn (labeled_text_rules + generic) — nên để BẬT:
# use_labeled_text_rules=true
# Neo cụm BẮT ĐẦU: chỉ giữ nội dung từ dòng chứa cụm này trở xuống (bỏ quốc hiệu/
# letterhead phía trên). So khớp bỏ dấu. "" = tắt. Không thấy cụm -> giữ nguyên cả trang.
# ocr_start_anchor=hợp đồng cung ứng

# === Đường dẫn (hiếm khi cần đổi) ===
# Thư mục tạm mỗi phiên chạy (mặc định backend/temp — dọn bằng npm run clear):
# temp_dir=
# Kho vector ChromaDB (mặc định backend/chroma_data). ĐỔI -> phải npm run seed lại:
# chroma_persist_dir=
# chroma_collection=regulations

# Môi trường chạy: local (máy cá nhân) | production (bật danh sách kiểm phát hành).
app_env=local
