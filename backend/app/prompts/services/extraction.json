  "document_no_rules": {
    "so_cong_van": {
      "regex": "((?:\\A|\\n)\\s*s[ố]?\\s*(?:công\\s*văn|văn\\s*bản|hồ\\s*sơ)?\\s*[:\\-]\\s*)((?=[A-Za-z0-9\\/\\-\\.\\_]*\\d)(?=[A-Za-z0-9\\/\\-\\.\\_]*\\/)[A-Z0-9][A-Z0-9\\/\\-\\.\\_]{2,30})",
      "confidence": 0.75,
      "auto_check": true,
      "_note": "Số công văn dạng '114/NHHK-2025' (bắt buộc có '/'); không lấy nhầm Mã hồ sơ (toàn số) hay Số lượng. NEO ĐẦU DÒNG và bắt buộc có dấu ':' vì bản scan hay rụng dấu ('Số:' -> 'S:') — nới chữ 'Số' mà không neo thì mọi chữ 's' trong văn bản đều thành ứng viên."
    },
    "so_giay_phep_dich_vu_viet_nam": {
      "regex": "(gi.?y\\s*ph.?p[^\\n]{0,90}?s.?\\s*[:\\-]\\s*\\n?\\s*)([A-Z0-9][A-Z0-9\\/\\-\\.]{3,30})",
      "confidence": 0.7,
      "auto_check": true,
      "_note": "Số giấy phép hoạt động dịch vụ ('1163/LĐTBXH-GP'). Nhãn và giá trị hay nằm KHÁC DÒNG trên bản scan nên cho phép một lần xuống dòng."
    },
    "ma_so_doanh_nghiep": {
      "regex": "((?:m[ãa]\\s*s[ốo]\\s*(?:doanh\\s*nghi[ệe]p|thu[ếe])?|MST|MSDN)\\s*[:\\-]?\\s*)(\\d{10}(?:-\\d{3})?)",
      "confidence": 0.75,
      "auto_check": true,
      "_note": "Mã số doanh nghiệp/MST 10 chữ số; văn bản đăng ký hay in ở khối chữ ký số."
    }
  },
